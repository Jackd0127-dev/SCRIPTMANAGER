{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptai.space/schemas/production-script.v1.json",
  "title": "ProductionScriptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scriptAutomationKey",
    "name",
    "status",
    "dueDate",
    "targetDurationSeconds",
    "platforms",
    "blocks",
    "productionNotes",
    "contentBacklink"
  ],
  "properties": {
    "scriptAutomationKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*:script$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "status": { "const": "draft" },
    "dueDate": { "type": "string", "format": "date" },
    "targetDurationSeconds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 600 },
        "max": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["TikTok", "Instagram", "YouTube", "X"] }
    },
    "projectRef": { "$ref": "#/$defs/exactRef" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/productionBlock" }
    },
    "productionNotes": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "contentBacklink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": { "const": "https://content.novasagency.com" }
      }
    }
  },
  "$defs": {
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expectedName"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expectedName": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds"],
      "properties": {
        "startSeconds": { "type": "number", "minimum": 0 },
        "endSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "blockBase": {
      "type": "object",
      "required": ["automationBlockKey", "order", "label", "timeRange", "type"],
      "properties": {
        "automationBlockKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
        },
        "order": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "timeRange": { "$ref": "#/$defs/timeRange" },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "productionBlock": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/blockBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["automationBlockKey", "order", "label", "timeRange", "type", "spokenText"],
              "properties": {
                "automationBlockKey": { "type": "string" },
                "order": { "type": "integer" },
                "label": { "type": "string" },
                "timeRange": { "$ref": "#/$defs/timeRange" },
                "notes": { "type": "string" },
                "type": { "enum": ["speech", "voiceover"] },
                "spokenText": { "type": "string", "minLength": 1, "maxLength": 5000 }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["automationBlockKey", "order", "label", "timeRange", "type", "subtitleKind", "text"],
          "properties": {
            "automationBlockKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
            "order": { "type": "integer", "minimum": 0 },
            "label": { "type": "string", "minLength": 1, "maxLength": 160 },
            "timeRange": { "$ref": "#/$defs/timeRange" },
            "notes": { "type": "string", "maxLength": 2000 },
            "type": { "const": "subtitle" },
            "subtitleKind": { "enum": ["spoken_caption", "editorial_text"] },
            "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
            "sourceSpeechBlockKey": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["automationBlockKey", "order", "label", "timeRange", "type", "shotDirection"],
          "properties": {
            "automationBlockKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
            "order": { "type": "integer", "minimum": 0 },
            "label": { "type": "string", "minLength": 1, "maxLength": 160 },
            "timeRange": { "$ref": "#/$defs/timeRange" },
            "notes": { "type": "string", "maxLength": 2000 },
            "type": { "const": "shot" },
            "shotDirection": { "type": "string", "minLength": 1, "maxLength": 3000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["automationBlockKey", "order", "label", "timeRange", "type", "transition"],
          "properties": {
            "automationBlockKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
            "order": { "type": "integer", "minimum": 0 },
            "label": { "type": "string", "minLength": 1, "maxLength": 160 },
            "timeRange": { "$ref": "#/$defs/timeRange" },
            "notes": { "type": "string", "maxLength": 2000 },
            "type": { "const": "transition" },
            "transition": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["automationBlockKey", "order", "label", "timeRange", "type", "direction"],
          "properties": {
            "automationBlockKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$" },
            "order": { "type": "integer", "minimum": 0 },
            "label": { "type": "string", "minLength": 1, "maxLength": 160 },
            "timeRange": { "$ref": "#/$defs/timeRange" },
            "notes": { "type": "string", "maxLength": 2000 },
            "type": { "const": "direction" },
            "direction": { "type": "string", "minLength": 1, "maxLength": 3000 }
          }
        }
      ]
    }
  }
}
