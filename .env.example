# Disabled by default. This server path creates draft planning scripts only.
CREATOR_PLANNING_AUTOMATION_ENABLED=false

# Local tests only. Production rejects the memory backend.
SCRIPTAI_AUTOMATION_BACKEND=firestore

# Firebase Admin (server only). Application-default credentials are also
# supported in the intended Google environment.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Existing AI generation service.
GEMINI_API_KEY=

# Disabled until the Access dual-auth migration and rollback gates are verified.
CENTRAL_IDENTITY_MODE=off
CENTRAL_IDENTITY_ISSUER=https://scriptai.space
CENTRAL_IDENTITY_LINK_AUDIENCE=https://access.novasagency.com/identity-link
CENTRAL_IDENTITY_LINK_KEY_ID=scriptai-link-1
CENTRAL_IDENTITY_LINK_PRIVATE_KEY=
CENTRAL_IDENTITY_PROVISIONING_SECRET=
